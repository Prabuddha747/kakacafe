rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitive helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'gardaaiacademyofficial@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name', 'slug', 'category', 'description', 'price',
          'rating', 'reviewsCount', 'image', 'isBestSeller',
          'isBeverage', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'slug', 'category', 'description', 'price',
          'rating', 'reviewsCount', 'image', 'isBestSeller',
          'isBeverage', 'active', 'tag', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9-]+$')
        && data.category is string && data.category in [
          'Hot Coffee', 'Cold Coffee', 'Espresso', 'Frappes', 'Milkshakes', 'Tea', 'Snacks & Desserts'
        ]
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 400
        && (data.price is int || data.price is float) && data.price > 0 && data.price <= 10000
        && (data.rating is int || data.rating is float) && data.rating >= 1 && data.rating <= 5
        && data.reviewsCount is int && data.reviewsCount >= 0 && data.reviewsCount <= 1000000
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 300
        && data.isBestSeller is bool
        && data.isBeverage is bool
        && data.active is bool
        && (!('tag' in data) || (data.tag is string && data.tag.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'name', 'slug', 'description', 'image', 'displayOrder', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'slug', 'description', 'image', 'displayOrder', 'active', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 50
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 60 && data.slug.matches('^[a-z0-9-]+$')
        && data.description is string && data.description.size() <= 200
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 300
        && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 100
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOffer(data) {
      return data.keys().hasAll([
          'title', 'subtitle', 'code', 'discountType', 'discountValue',
          'targetCategory', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'subtitle', 'code', 'discountType', 'discountValue',
          'targetCategory', 'active', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.subtitle is string && data.subtitle.size() >= 4 && data.subtitle.size() <= 160
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9_-]+$')
        && data.discountType is string && data.discountType in ['bogo', 'combo', 'percent', 'flat']
        && (data.discountValue is int || data.discountValue is float) && data.discountValue >= 0 && data.discountValue <= 10000
        && data.targetCategory is string && data.targetCategory.size() <= 50
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail',
          'orderType', 'deliveryAddress', 'paymentMethod', 'status', 'items',
          'subtotal', 'deliveryFee', 'tax', 'discount', 'promoCode', 'total',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail',
          'orderType', 'deliveryAddress', 'paymentMethod', 'status', 'items',
          'subtotal', 'deliveryFee', 'tax', 'discount', 'promoCode', 'total',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 24
        && data.userId is string && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 20
        && data.customerEmail is string && data.customerEmail.size() <= 120
        && data.orderType is string && data.orderType in ['Pickup', 'Delivery']
        && data.deliveryAddress is string && data.deliveryAddress.size() <= 300
        && data.paymentMethod is string && data.paymentMethod in ['Cash on Delivery', 'UPI']
        && data.status is string && data.status in [
          'Pending', 'Confirmed', 'Preparing', 'Ready', 'Out for Delivery', 'Completed', 'Cancelled'
        ]
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 25
        && data.items[0] is map
        && data.items[0].productId is string && data.items[0].productId.size() <= 128
        && data.items[0].name is string && data.items[0].name.size() <= 80
        && data.items[0].quantity is int && data.items[0].quantity >= 1 && data.items[0].quantity <= 50
        && (data.items[0].unitPrice is int || data.items[0].unitPrice is float) && data.items[0].unitPrice >= 0
        && (data.subtotal is int || data.subtotal is float) && data.subtotal >= 0 && data.subtotal <= 100000
        && (data.deliveryFee is int || data.deliveryFee is float) && data.deliveryFee >= 0 && data.deliveryFee <= 500
        && (data.tax is int || data.tax is float) && data.tax >= 0 && data.tax <= 20000
        && (data.discount is int || data.discount is float) && data.discount >= 0 && data.discount <= 50000
        && data.promoCode is string && data.promoCode.size() <= 24
        && (data.total is int || data.total is float) && data.total >= 0 && data.total <= 120000
        && data.notes is string && data.notes.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt'])
        && data.keys().hasOnly(['userId', 'email', 'createdAt'])
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'phone', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'email', 'phone', 'message', 'status', 'createdAt'])
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 1000
        && data.status is string && data.status in ['New', 'Reviewed']
        && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // Products catalog
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'category', 'description', 'price', 'rating',
          'reviewsCount', 'image', 'isBestSeller', 'isBeverage', 'active', 'tag', 'updatedAt'
        ]);
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'image', 'displayOrder', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Offers
    match /offers/{offerId} {
      allow get: if isValidId(offerId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(offerId) && isAdmin() && isValidOffer(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(offerId) && isAdmin() && isValidOffer(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'code', 'discountType', 'discountValue',
          'targetCategory', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(offerId) && isAdmin();
    }

    // Orders (PII isolated to owner or admin)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(orderId) && isVerifiedUser() && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isVerifiedUser() && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (
            existing().userId == request.auth.uid
            && existing().status == 'Pending'
            && incoming().status == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Newsletter subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(subscriberId) && isVerifiedUser() && isValidSubscriber(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(subscriberId) && (
        (isVerifiedUser() && existing().userId == request.auth.uid) || isAdmin()
      );
    }

    // Contact messages
    match /contact_messages/{messageId} {
      allow get: if isValidId(messageId) && isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(messageId) && isVerifiedUser() && isValidContactMessage(incoming())
        && incoming().status == 'New'
        && incoming().createdAt == request.time;
      allow update: if isValidId(messageId) && isAdmin() && isValidContactMessage(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // Admin role registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (
        request.auth.uid == userId || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
